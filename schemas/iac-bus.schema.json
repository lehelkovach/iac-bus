{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iac-bus.local/schemas/iac-bus.schema.json",
  "title": "IAC Bus Protocol",
  "type": "object",
  "description": "Schema definitions for IAC Bus message, queue, lock and run endpoints.",
  "$defs": {
    "MessageCreate": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "default": "iac-bus/1.1"
        },
        "channel": {
          "type": "string",
          "default": "default"
        },
        "sender": {
          "type": "string",
          "default": "agent"
        },
        "message": {
          "description": "Payload",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "type": {
          "type": "string",
          "default": "event"
        },
        "conversation_id": {
          "type": "string"
        },
        "reply_to": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "queue": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "default": 0
        },
        "headers": {
          "type": "object"
        },
        "ttl_seconds": {
          "type": "number",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "orchestration.job"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "$ref": "#/$defs/OrchestrationJobEnvelope"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "orchestration.step.assign"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "$ref": "#/$defs/OrchestrationStepAssignment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "orchestration.step.status"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "$ref": "#/$defs/OrchestrationStepStatus"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "Message": {
      "type": "object",
      "required": [
        "id",
        "ts",
        "channel",
        "sender",
        "message"
      ],
      "properties": {
        "protocol": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ts": {
          "type": "number"
        },
        "channel": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        },
        "message": {
          "description": "Payload",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "type": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "reply_to": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "queue": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "headers": {
          "type": "object"
        },
        "ttl_seconds": {
          "type": "number",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "pending",
            "leased"
          ]
        },
        "leased_by": {
          "type": "string"
        },
        "lease_until": {
          "type": "number"
        },
        "lease_id": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "orchestration.job"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "$ref": "#/$defs/OrchestrationJobEnvelope"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "orchestration.step.assign"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "$ref": "#/$defs/OrchestrationStepAssignment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "orchestration.step.status"
              }
            }
          },
          "then": {
            "properties": {
              "message": {
                "$ref": "#/$defs/OrchestrationStepStatus"
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "OrchestrationJobEnvelope": {
      "type": "object",
      "required": [
        "job"
      ],
      "properties": {
        "job": {
          "$ref": "https://iac-bus.local/schemas/orchestration.schema.json"
        }
      },
      "additionalProperties": true
    },
    "OrchestrationStepAssignment": {
      "type": "object",
      "required": [
        "job_id",
        "step"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "step": {
          "$ref": "https://iac-bus.local/schemas/orchestration.schema.json#/$defs/StepSpec"
        }
      },
      "additionalProperties": true
    },
    "OrchestrationStepStatus": {
      "type": "object",
      "required": [
        "job_id",
        "step_id",
        "status"
      ],
      "properties": {
        "job_id": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "skipped",
            "timed_out"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "QueueClaimRequest": {
      "type": "object",
      "required": [
        "queue",
        "worker"
      ],
      "properties": {
        "queue": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        },
        "lease_seconds": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "QueueAckRequest": {
      "type": "object",
      "required": [
        "queue",
        "message_id",
        "worker",
        "lease_id"
      ],
      "properties": {
        "queue": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        },
        "lease_id": {
          "type": "string"
        },
        "result": {
          "description": "Optional outcome of the work (string or JSON). For A2A tasks it becomes the task's artifact."
        }
      },
      "additionalProperties": false
    },
    "QueueNackRequest": {
      "type": "object",
      "required": [
        "queue",
        "message_id",
        "worker",
        "lease_id",
        "requeue"
      ],
      "properties": {
        "queue": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        },
        "lease_id": {
          "type": "string"
        },
        "requeue": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "description": "Why the work was handed back; for A2A tasks dropped with requeue=false it becomes the failure message."
        }
      },
      "additionalProperties": false
    },
    "LockAcquireRequest": {
      "type": "object",
      "required": [
        "resource",
        "agent"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path. A lock on a folder covers everything below it; '.' is the repo root. Absolute paths, '..' escapes and glob characters are rejected."
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "default": "default",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)?$",
          "description": "Lock scope. The same path in two repos never conflicts."
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ],
          "default": "exclusive"
        },
        "ttl_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 300,
          "description": "Capped at BUS_LOCK_TTL_MAX_SECONDS (default 3600)."
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "wait_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Block up to this long (capped at BUS_WAIT_SECONDS_MAX) for conflicting locks to clear."
        }
      },
      "additionalProperties": false
    },
    "Lock": {
      "type": "object",
      "description": "A lock as anyone may see it. Never contains lock_id.",
      "required": [
        "repo",
        "resource",
        "mode",
        "agent",
        "reason",
        "fencing_token",
        "acquired_at",
        "expires_at",
        "ttl_seconds"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ]
        },
        "agent": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "fencing_token": {
          "type": "integer"
        },
        "acquired_at": {
          "type": "number",
          "description": "Unix seconds"
        },
        "renewed_at": {
          "type": "number",
          "description": "Unix seconds"
        },
        "expires_at": {
          "type": "number",
          "description": "Unix seconds"
        },
        "ttl_seconds": {
          "type": "number"
        },
        "released_at": {
          "type": "number",
          "description": "Unix seconds; release events only"
        }
      },
      "not": {
        "required": [
          "lock_id"
        ]
      }
    },
    "LockAcquireResponse": {
      "description": "200 from POST /bus/locks/acquire. The only place a lock_id is returned.",
      "allOf": [
        {
          "$ref": "#/$defs/LockWithId"
        }
      ],
      "properties": {
        "waited_seconds": {
          "type": "number"
        }
      }
    },
    "LockWithId": {
      "type": "object",
      "description": "A lock as its holder sees it, including the lock_id capability.",
      "required": [
        "lock_id",
        "repo",
        "resource",
        "mode",
        "agent",
        "fencing_token",
        "expires_at"
      ],
      "properties": {
        "lock_id": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ]
        },
        "agent": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "fencing_token": {
          "type": "integer"
        },
        "acquired_at": {
          "type": "number"
        },
        "renewed_at": {
          "type": "number"
        },
        "expires_at": {
          "type": "number"
        },
        "ttl_seconds": {
          "type": "number"
        }
      }
    },
    "LockConflict": {
      "type": "object",
      "description": "409 from POST /bus/locks/acquire. Top-level holder fields describe the oldest conflicting lock.",
      "required": [
        "error",
        "held_by",
        "mode",
        "reason",
        "expires_at",
        "conflicts"
      ],
      "properties": {
        "error": {
          "const": "lock conflict"
        },
        "repo": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "requested_mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ]
        },
        "held_by": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ]
        },
        "reason": {
          "type": "string"
        },
        "expires_at": {
          "type": "number"
        },
        "conflicting_resource": {
          "type": "string"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Lock"
          }
        },
        "waited_seconds": {
          "type": "number"
        }
      },
      "not": {
        "required": [
          "lock_id"
        ]
      }
    },
    "LockRenewRequest": {
      "type": "object",
      "required": [
        "lock_id",
        "agent"
      ],
      "properties": {
        "lock_id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "ttl_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 300
        }
      },
      "additionalProperties": false
    },
    "LockReleaseRequest": {
      "type": "object",
      "required": [
        "lock_id",
        "agent"
      ],
      "properties": {
        "lock_id": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "LockValidateRequest": {
      "type": "object",
      "description": "POST /bus/locks/validate: 200 when fencing_token is a live lock covering resource, else 409.",
      "required": [
        "resource",
        "fencing_token"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path. A lock on a folder covers everything below it; '.' is the repo root. Absolute paths, '..' escapes and glob characters are rejected."
        },
        "fencing_token": {
          "type": "integer"
        },
        "repo": {
          "type": "string",
          "default": "default",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)?$",
          "description": "Lock scope. The same path in two repos never conflicts."
        },
        "agent": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "LockValidateResponse": {
      "type": "object",
      "required": [
        "valid",
        "reason",
        "fencing_token"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "fencing_token": {
          "type": "integer"
        },
        "lock": {
          "oneOf": [
            {
              "$ref": "#/$defs/Lock"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LockList": {
      "type": "object",
      "description": "GET /bus/locks?resource_prefix=&repo=&agent=. resource_prefix returns every lock overlapping that path, including parent-folder locks.",
      "required": [
        "locks",
        "count"
      ],
      "properties": {
        "locks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Lock"
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "LockEvent": {
      "type": "object",
      "description": "Message the bus posts to channel 'locks' with sender 'iac-bus'.",
      "required": [
        "channel",
        "sender",
        "type",
        "message"
      ],
      "properties": {
        "channel": {
          "const": "locks"
        },
        "sender": {
          "const": "iac-bus"
        },
        "type": {
          "enum": [
            "lock.acquired",
            "lock.released",
            "lock.expired"
          ]
        },
        "message": {
          "$ref": "#/$defs/Lock"
        }
      }
    },
    "AgentRegisterRequest": {
      "type": "object",
      "description": "POST /agents/register with the shared token (or on an open bus). A run token cannot register.",
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@/+-]{1,128}$",
          "default": "agent",
          "description": "Agent handle; the run's actor is '<handle>#<first 6 hex of run_id>'."
        },
        "agent_handle": {
          "type": "string",
          "description": "Alias of handle."
        },
        "role": {
          "type": "string",
          "default": "worker"
        },
        "purpose": {
          "type": "string"
        },
        "medium": {
          "enum": [
            "web",
            "slack",
            "ide",
            "api",
            "automation",
            "other",
            ""
          ]
        },
        "session_id": {
          "type": "string"
        },
        "run_ttl_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 3600,
          "description": "Sliding expiry; capped at BUS_RUN_TTL_MAX_SECONDS (default 86400)."
        },
        "grants": {
          "$ref": "#/$defs/Grants"
        }
      }
    },
    "Run": {
      "type": "object",
      "description": "A run as the bus shows it. Never contains the token or its hash.",
      "required": [
        "run_id",
        "agent_uuid",
        "handle",
        "actor",
        "status",
        "started_at",
        "last_seen_at",
        "expires_at",
        "ttl_seconds"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "agent_uuid": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "ended",
            "expired"
          ]
        },
        "started_at": {
          "type": "number"
        },
        "last_seen_at": {
          "type": "number"
        },
        "expires_at": {
          "type": "number"
        },
        "ttl_seconds": {
          "type": "number"
        },
        "ended_at": {
          "type": [
            "number",
            "null"
          ]
        },
        "grants": {
          "oneOf": [
            {
              "$ref": "#/$defs/Grants"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "token_hash"
            ]
          },
          {
            "required": [
              "run_token"
            ]
          }
        ]
      }
    },
    "AgentRegisterResponse": {
      "type": "object",
      "description": "201 from POST /agents/register. run_token is shown once; send it as the bearer token.",
      "required": [
        "success",
        "agent",
        "run",
        "actor",
        "run_token"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "agent": {
          "type": "object",
          "required": [
            "agent_uuid",
            "agent_handle"
          ]
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "actor": {
          "type": "string"
        },
        "run_token": {
          "type": "string",
          "pattern": "^iacrun_"
        }
      }
    },
    "Whoami": {
      "type": "object",
      "description": "GET /agents/whoami. auth is 'run', 'shared' or 'open'.",
      "required": [
        "auth",
        "actor",
        "run"
      ],
      "properties": {
        "auth": {
          "enum": [
            "run",
            "shared",
            "open"
          ]
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "oneOf": [
            {
              "$ref": "#/$defs/Run"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RunList": {
      "type": "object",
      "description": "GET /agents/runs?include_ended=",
      "required": [
        "runs",
        "count"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Run"
          }
        },
        "count": {
          "type": "integer"
        }
      }
    },
    "Grants": {
      "type": "object",
      "description": "Deny-by-default allowlists for a restricted run (fnmatch patterns; lock_paths are repo-relative paths that cover everything below them).",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "queues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lock_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "A2ARegisterRequest": {
      "type": "object",
      "description": "POST /agents/a2a/register (shared token). Exactly one of card_url (fetched: https, public addresses unless in BUS_A2A_ALLOW_HOSTS) or card.",
      "properties": {
        "card_url": {
          "type": "string",
          "format": "uri"
        },
        "card": {
          "type": "object",
          "description": "An A2A 1.0 AgentCard (camelCase JSON)."
        },
        "handle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@/+-]{1,128}$",
          "description": "Default: a slug of the card name."
        },
        "grants": {
          "$ref": "#/$defs/Grants"
        },
        "credential_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "description": "NAME of the env var on the bridge host holding the token for calling this agent. Never a value."
        },
        "run_ttl_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "card_url"
          ]
        },
        {
          "required": [
            "card"
          ]
        }
      ],
      "additionalProperties": false
    },
    "A2ARegisterResponse": {
      "type": "object",
      "required": [
        "success",
        "agent",
        "run",
        "actor",
        "run_token",
        "outbound_queue"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "agent": {
          "type": "object",
          "required": [
            "agent_uuid",
            "handle",
            "card",
            "grants",
            "outbound_queue"
          ]
        },
        "run": {
          "$ref": "#/$defs/Run"
        },
        "actor": {
          "type": "string"
        },
        "run_token": {
          "type": "string",
          "pattern": "^iacrun_"
        },
        "outbound_queue": {
          "type": "string",
          "description": "Queue the outbound bridge reads for work addressed to this agent."
        },
        "updated": {
          "type": "boolean"
        }
      }
    },
    "QueueRenewRequest": {
      "type": "object",
      "description": "POST /bus/queues/renew: extend a live lease (409 when expired, owner or lease id mismatch).",
      "required": [
        "queue",
        "message_id",
        "worker",
        "lease_id"
      ],
      "properties": {
        "queue": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        },
        "lease_id": {
          "type": "string"
        },
        "lease_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
